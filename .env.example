# Copy thành .env rồi điền key; không commit .env.
OLLAMA_API_KEY=your_ollama_api_key
LLM_MODEL_NAME=gemma4:31b

# Tùy chọn; mặc định gọi trực tiếp Ollama Cloud.
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_TIMEOUT_SECONDS=300
LLM_MAX_ATTEMPTS=3
LLM_RETRY_DELAY_SECONDS=2
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=8192
